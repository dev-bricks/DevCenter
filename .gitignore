# =============================================================================
# .gitignore Template fuer Software Entwicklung Projekte
# Kopieren und als .gitignore im Projektroot ablegen
# Projektspezifische Eintraege am Ende anfuegen
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
.pytest_cache/
.pytest_temp/
.pytest_tmp*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/
.tox/
.hypothesis/
.turbo/
.nyc_output/
wheelhouse/
.wheel-smoke/

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- BACH Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
DIAGNOSE_REPORT.md
SKILL.md

# ---- Persoenliche / Sensible Daten ----
_USER/
.env
.env.*
*.env
credentials.json
client_secret*.json
token.json
*.pem
*.pfx
*.key
keyring/
secrets/
secret/
secrets.*
*.secret
*.secrets
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# ---- Build-Artefakte & Releases ----
releases/
*.exe
*.msi
*.msix
*.appx
*.spec
logs/
*.log
*.tmp
*.bak
*.orig
*.rej

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem ----
desktop.ini
Desktop.ini
Thumbs.db
thumbs.db
.DS_Store
ehthumbs.db

# ---- Lokale Sync-/Host-Nebenstaende ----
*-WORKSTATION*
*-WORKSTATION-LG*
*-WORKSTATION.*
*-WORKSTATION-LG.*
*-ASUS*
*-ASUS-GEI*
*-ASUS-GEI.md
*-ASUS-GEI.*
*-IDEAPAD*
*-IDEAPAD-GEI*
*-IDEAPAD-GEI.*
*-LAPTOP*
*-Mac Studio*
*-MacBook*
*.sync-conflict-*
*.conflict
*conflicted copy*
* (kopie)*
* (copy)*
* (Kopie)*
* (Copy)*
*.sync-temp-*
*-CONFLIT-*

# ---- Standard-Patterns ----
PLAN.txt
_archive/
_private/

# ---- Projektspezifisch (hier eigene Eintraege anfuegen) ----
DECISIONS.md
PORTIERUNGSPLAN.md
TODO.md
DONE.md

# Lokale Agenten-Locks (LOCK-System)
LOCK
LOCK*.txt
LOCK.*
LOCK.user.*
LOCK.until.*
LOCK.condition.*
*.lock
uv.lock
!package-lock.json
LOCK.permissions.json
TASKPLAN_*.md
*-TASKPLAN*
LOCK.dev.*
LOCK.antigravity.*
LOCK.bugsearch.*

# Interne Analyse-/Planungsdokumente
ANALYSIS_builder_refactoring.md
